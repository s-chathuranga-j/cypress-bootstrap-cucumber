{
  "stepDefinitions": [
    "cypress/tests/[filepath].steps.ts",
    "cypress/tests/[filepath]/steps.ts",
    "cypress/support/step_definitions/**/*.ts"
  ],
  "filterSpecs": true,
  "omitFiltered": true,
  "json": {
    "enabled": true,
    "output": "cypress/reports/cucumber/cucumber-report.json"
  },
  "html": {
    "enabled": true,
    "output": "cypress/reports/cucumber/cucumber-report.html"
  },
  "messages": {
    "enabled": true,
    "output": "cypress/reports/cucumber/messages.ndjson"
  },
  "attachments": {
    "addScreenshots": true,
    "addVideos": true
  }
}
